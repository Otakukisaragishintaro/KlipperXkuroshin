+    @staticmethod
+    def _median(values):
+        values = sorted(values)
+        count = len(values)
+        middle = count // 2
+        if count % 2:
+            return values[middle]
+        return (values[middle - 1] + values[middle]) / 2.
+
+    def _filter_repeated_results(self, results, point_count, gcmd):
+        repeats = self.rapid_scan_repeats
+        expected_count = point_count * repeats
+        if len(results) != expected_count:
+            raise gcmd.error(
+                "bed_mesh: rapid scan returned %d results; expected %d "
+                "(%d points x %d passes)"
+                % (len(results), expected_count, point_count, repeats))
+        averaged_results = []
+        rejected_count = 0
+        for point_idx in range(point_count):
+            samples = [results[pass_idx * point_count + point_idx]
+                       for pass_idx in range(repeats)]
+            heights = [sample.bed_z for sample in samples]
+            center = self._median(heights)
+            mad = self._median([abs(height - center)
+                                for height in heights])
+            threshold = max(
+                self.rapid_scan_outlier_min,
+                self.rapid_scan_mad_multiplier * 1.4826 * mad)
+            valid_samples = [
+                sample for sample in samples
+                if abs(sample.bed_z - center) <= threshold]
+            rejected_count += len(samples) - len(valid_samples)
+            if len(valid_samples) < 2:
+                raise gcmd.error(
+                    "bed_mesh: fewer than two valid repeated scan samples "
+                    "at path point %d (MAD %.6fmm, threshold %.6fmm)"
+                    % (point_idx, mad, threshold))
+            avg_z = (sum(sample.bed_z for sample in valid_samples)
+                     / len(valid_samples))
+            averaged_results.append(
+                samples[0]._replace(bed_z=avg_z))
+        logging.info(
+            "bed_mesh: rapid scan MAD filter rejected %d of %d samples "
+            "across %d path points",
+            rejected_count, expected_count, point_count)
+        return averaged_results
+
